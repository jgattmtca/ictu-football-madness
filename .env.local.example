# ── Supabase ──────────────────────────────────────────────────────────────────
# Get these from https://supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── Football API (api-football.com) ───────────────────────────────────────────
# Sign up free at https://rapidapi.com/api-sports/api/api-football
API_FOOTBALL_KEY=YOUR_API_FOOTBALL_KEY

# ── SendGrid (automated emails) ───────────────────────────────────────────────
# Sign up free at https://sendgrid.com → Settings → API Keys
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=yourname@yourdomain.com
SENDGRID_FROM_NAME=ICTU Football Madness

# ── Admin password ────────────────────────────────────────────────────────────
# Simple password to protect the /admin section
ADMIN_PASSWORD=choose_a_strong_password_here

# ── App URL ───────────────────────────────────────────────────────────────────
# Set to your Vercel deployment URL in production
NEXT_PUBLIC_APP_URL=http://localhost:3000
